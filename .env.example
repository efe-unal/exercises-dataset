# Copy to .env and edit before exposing the API publicly.
# Never commit the filled-in .env — it is ignored by .gitignore.

# --- database ---------------------------------------------------------
# SQLite by default; fine for a single server. Point at Postgres to scale out
# or to survive a container with no persistent disk.
#   postgresql+psycopg://user:password@host:5432/exercises
DATABASE_URL=sqlite:///./exercises.db

# --- front-end origins ------------------------------------------------
# Browsers refuse cross-origin calls unless the API names the origins it
# trusts. "*" is development-only: it disables credentialed requests and
# permits any site to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# --- catalog API keys -------------------------------------------------
# The developer-facing product. Format: key:tier, comma separated.
# LEAVING THESE UNSET LEAVES THE CATALOG OPEN TO EVERYONE.
EXERCISES_API_KEYS=
EXERCISES_REQUIRE_KEY=0

# --- email ------------------------------------------------------------
# Password reset needs to deliver a link. No provider is wired up: "console"
# logs the message instead of sending it, so the flow is fully usable in
# development but a real user cannot recover their password. Implement a
# backend in app/mail.py and name it here to turn the feature on.
EMAIL_BACKEND=console

# Where the reset link points — the app's own page, with {token} substituted.
PASSWORD_RESET_URL=http://localhost:5173/reset-password?token={token}

# --- push notifications -----------------------------------------------
# Unlike email, this needs no third-party account: a push message travels
# over the browser vendor's own service, and a VAPID key pair you generate
# yourself is all they need to trust it. Generate one once:
#
#   python -m app.push generate-keys
#
# Keep VAPID_PRIVATE_KEY secret and keep it stable — changing it invalidates
# every subscription, and everyone has to allow notifications again.
# With these unset the app still records notifications and shows them in the
# list; only delivery to a closed app is missing.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY_RAW=
# Required by the push services, as somewhere to complain to.
VAPID_SUBJECT=mailto:you@example.com

# --- rate limiting ----------------------------------------------------
# Requests per minute per IP. The auth limit guards login and registration
# against password guessing, so keep it low.
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
