# Copy to .env and edit before exposing the API publicly.
# Never commit the filled-in .env — it is ignored by .gitignore.

# --- database ---------------------------------------------------------
# SQLite by default; fine for a single server. Point at Postgres to scale out
# or to survive a container with no persistent disk.
#   postgresql+psycopg://user:password@host:5432/exercises
DATABASE_URL=sqlite:///./exercises.db

# --- front-end origins ------------------------------------------------
# Browsers refuse cross-origin calls unless the API names the origins it
# trusts. "*" is development-only: it disables credentialed requests and
# permits any site to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# --- catalog API keys -------------------------------------------------
# The developer-facing product. Format: key:tier, comma separated.
# LEAVING THESE UNSET LEAVES THE CATALOG OPEN TO EVERYONE.
EXERCISES_API_KEYS=
EXERCISES_REQUIRE_KEY=0

# --- rate limiting ----------------------------------------------------
# Requests per minute per IP. The auth limit guards login and registration
# against password guessing, so keep it low.
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
